<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ترانه‌جو</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="/icon-192.png" sizes="192x192">

  <script>
    // درخواست مجوز نوتیفیکیشن
    document.addEventListener('DOMContentLoaded', () => {
      if ('Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission();
      }
    });
  </script>
</head>
<body style="font-family: 'Vazirmatn', system-ui, sans-serif; background:#0f1724; color:#fff;">
  <header class="header p-4 bg-black/70 sticky top-0 z-30">
    <div class="container mx-auto flex items-center justify-between">
      <a href="/" class="text-teal-300 text-xl font-bold">ترانه‌جو</a>
      <div class="flex items-center gap-3">
        <% if (!user) { %>
          <a href="/login" class="btn">ورود</a>
          <a href="/register" class="btn outline">ثبت‌نام</a>
        <% } else { %>
          <div class="flex items-center gap-3">
            <div class="avatar w-10 h-10 rounded-full bg-teal-500 flex items-center justify-center font-bold">
              <%= (user.display_name || user.username)[0].toUpperCase() %>
            </div>
            <div class="text-sm">
              <div><%= user.display_name || user.username %></div>
              <% if (!user.is_admin) { %>
                <div class="text-xs text-gray-300">اشتراک: <%= user.subscription_end ? (new Date(user.subscription_end)).toLocaleDateString() : 'ندارد' %></div>
              <% } else { %>
                <div class="text-xs text-gray-300">ادمین</div>
              <% } %>
            </div>
            <a href="/logout" class="btn">خروج</a>
          </div>
        <% } %>
      </div>
    </div>
  </header>

  <main class="container mx-auto p-4 pb-32">
    <%- body %>
  </main>

  <footer class="text-center p-4 text-gray-400">
    © 2025 ترانه‌جو
  </footer>

  <script src="/js/artist-view.js" defer></script>
</body>
</html>