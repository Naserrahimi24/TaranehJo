<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>ورود ادمین</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center h-screen">
  <form action="/admin/login" method="post" class="bg-gray-800 p-6 rounded w-80 space-y-4">
    <h2 class="text-xl font-bold text-center mb-4">ورود مدیر</h2>

    <% if (error) { %>
      <p class="text-red-400 text-sm text-center"><%= error %></p>
    <% } %>

    <input type="text" name="username" placeholder="نام کاربری" class="w-full p-2 rounded bg-gray-700 border-none text-white" required>
    <input type="password" name="password" placeholder="رمز عبور" class="w-full p-2 rounded bg-gray-700 border-none text-white" required>

    <button type="submit" class="w-full bg-teal-500 hover:bg-teal-600 p-2 rounded">ورود</button>
  </form>
</body>
</html>
