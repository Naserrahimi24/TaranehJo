<section>
  <h2 class="text-xl font-bold mb-4">ورود</h2>
  <form method="post" action="/login" class="space-y-3 max-w-sm">
    <label class="block">نام کاربری:
      <input name="username" class="border rounded p-2 w-full" required>
    </label>
    <label class="block">رمز عبور:
      <input name="password" type="password" class="border rounded p-2 w-full" required>
    </label>
    <% if (error) { %><div class="text-red-500"><%= error %></div><% } %>
    <button type="submit" class="btn">ورود</button>
  </form>
</section>
